{
  "provider": "openai_compat",
  "name": "OpenAI",
  "default_base_url": "https://api.openai.com/v1",
  "auth_type": "bearer",
  "default_model": "gpt-4o-mini",
  "models": ["gpt-4o-mini", "gpt-4o", "gpt-3.5-turbo"],
  "capabilities": {
    "chat": true,
    "stream": true,
    "tools": true,
    "vision": true,
    "embeddings": false,
    "json_mode": true,
    "structured": true
  },
  "settings": {
    "timeout_s": 30,
    "temperature": 0.7
  }
}
